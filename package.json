{
  "name": "karar-cad-to-bim",
  "version": "1.0.0-RC1",
  "type": "module",
  "scripts": {
    "dev": "tsx server.ts",
    "build": "vite build && esbuild server.ts --bundle --platform=node --format=cjs --packages=external --sourcemap --outfile=dist/server.cjs",
    "start": "node dist/server.cjs",
    "lint": "tsc --noEmit",
    "doctor": "node scripts/dev-tools.mjs doctor",
    "preflight": "node scripts/dev-tools.mjs preflight",
    "context:guard": "node scripts/dev-tools.mjs context-guard",
    "setup:python": "node scripts/dev-tools.mjs setup:python",
    "install-all": "node scripts/dev-tools.mjs bootstrap",
    "test:python": "node scripts/dev-tools.mjs unittest backend.tests.test_modern_pipeline",
    "test:geometry": "node scripts/dev-tools.mjs targeted-test geometry",
    "test:topology": "node scripts/dev-tools.mjs targeted-test topology",
    "test:pipeline": "node scripts/dev-tools.mjs targeted-test pipeline",
    "test:bim": "node scripts/dev-tools.mjs targeted-test bim",
    "test:regression": "node scripts/dev-tools.mjs targeted-test regression",
    "manifest:update": "node scripts/dev-tools.mjs manifest update",
    "manifest:verify": "node scripts/dev-tools.mjs manifest verify",
    "metrics:update": "node scripts/dev-tools.mjs metrics update",
    "metrics:verify": "node scripts/dev-tools.mjs metrics verify",
    "topology:health": "node scripts/dev-tools.mjs topology-health",
    "verify:p0": "node scripts/dev-tools.mjs verify:p0",
    "release:gate": "node scripts/dev-tools.mjs release-gate",
    "hard:geometry": "node scripts/dev-tools.mjs hard-mode geometry",
    "hard:topology": "node scripts/dev-tools.mjs hard-mode topology",
    "hard:pipeline": "node scripts/dev-tools.mjs hard-mode pipeline",
    "hard:bim": "node scripts/dev-tools.mjs hard-mode bim",
    "hard:regression": "node scripts/dev-tools.mjs hard-mode regression",
    "demo": "node scripts/dev-tools.mjs regression",
    "check": "npm run lint && npm run doctor && npm run context:guard && npm run test:python"
  },
  "dependencies": {
    "@google/genai": "*",
    "@tailwindcss/vite": "^4.3.3",
    "express": "^4.19.2",
    "lucide-react": "^0.399.0",
    "motion": "^11.11.17",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-markdown": "^9.0.1",
    "tailwindcss": "^4.3.3",
    "three": "^0.166.1"
  },
  "devDependencies": {
    "@types/express": "^4.17.21",
    "@types/react": "^18.3.3",
    "@types/react-dom": "^18.3.0",
    "@types/three": "^0.166.0",
    "@vitejs/plugin-react": "^4.3.1",
    "esbuild": "^0.21.5",
    "tsx": "^4.15.7",
    "typescript": "^5.4.5",
    "vite": "^5.3.1"
  }
}
