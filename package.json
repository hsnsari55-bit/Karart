{
  "name": "karar-cad-to-bim",
  "version": "1.0.0-RC1",
  "type": "module",
  "scripts": {
    "dev": "tsx server.ts",
    "build": "vite build && esbuild server.ts --bundle --platform=node --format=cjs --packages=external --sourcemap --outfile=dist/server.cjs",
    "start": "node dist/server.cjs",
    "lint": "tsc --noEmit",
    "install-all": "npm install && python3 -m venv venv && venv/bin/pip install --upgrade pip && venv/bin/pip install ezdxf shapely rtree scikit-learn numpy matplotlib trimesh ifcopenshell",
    "test:python": "PYTHONPATH=. venv/bin/python3 -m unittest backend/tests/test_modern_pipeline.py",
    "demo": "PYTHONPATH=. venv/bin/python3 backend/run_regression_tests.py"
  },
  "dependencies": {
    "@google/genai": "*",
    "@tailwindcss/vite": "^4.3.3",
    "express": "^4.19.2",
    "lucide-react": "^0.399.0",
    "motion": "^11.11.17",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-markdown": "^9.0.1",
    "tailwindcss": "^4.3.3",
    "three": "^0.166.1"
  },
  "devDependencies": {
    "@types/express": "^4.17.21",
    "@types/react": "^18.3.3",
    "@types/react-dom": "^18.3.0",
    "@types/three": "^0.166.0",
    "@vitejs/plugin-react": "^4.3.1",
    "esbuild": "^0.21.5",
    "tsx": "^4.15.7",
    "typescript": "^5.4.5",
    "vite": "^5.3.1"
  }
}
